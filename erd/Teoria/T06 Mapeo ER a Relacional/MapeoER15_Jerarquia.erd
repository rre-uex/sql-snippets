// header (required)
erdiagram SegundoEjemplo

// notation (optional)
notation=crowsfoot

// model elements
entity G { 
    id_G key
    atributos_comunes }

hierarchy h_g G total disjoint

entity E1 extends h_g { 
    id_G key 
    atributos_exclusivos_E1
    }

entity E2 extends h_g { 
    id_G key 
    atributos_exclusivos_E2
    }