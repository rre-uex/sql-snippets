// header (required)
erdiagram SegundoEjemplo

// notation (optional)
notation=crowsfoot

// model elements
entity E1 { 
    id_E1 key
    resto_atributos_E1 }

entity E2 { 
    id_E2 key 
    resto_atributos_E2
    }

entity E3 { 
    id_E3 key 
    resto_atributos_E3
    }

relationship RE1E2E3 {
    E1[1..N] -> E2[1..1] -> E3[1..1]
    atributos_RE1E2E3 
    }  

