//- Problem in Relationship "suministra": Expected 2 links, but found 1.

erdiagram Model
notation=crowsfoot

entity Proveedor {
id_proveedor key
}

entity Proyecto {
id_proyecto key
}

entity Repuesto {
id_repuesto key
}

relationship suministra {
Proveedor[1..N] -> Proyecto[1..N]  //- Problem in Relationship "suministra": Expected 2 links, but found 1.
cantidad
}
