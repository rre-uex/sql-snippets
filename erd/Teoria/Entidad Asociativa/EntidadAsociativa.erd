erdiagram Model
notation=crowsfoot

entity Puesto_de_Trabajo {
    id_puesto key
    nombre_puesto
}

entity Competencia {
    id_competencia key
    nombre_competencia
}

entity Validador {
    id_validador key
    rol_empresa
}

associative entity Asoc_Requisito_Puesto {
}

associative relationship requiere {
    Puesto_de_Trabajo[1..1] -> Asoc_Requisito_Puesto[1..N]
}

associative relationship es_requerida_por {
    Competencia[1..1] -> Asoc_Requisito_Puesto[0..N]
}


relationship validada_por {
    Asoc_Requisito_Puesto[0..N] -> Validador[1..1]
}