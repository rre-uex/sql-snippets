erdiagram Model
notation=crowsfoot

entity Estudiante {
    numero_expediente key
    nombre
    apellido1
    apellido2
    sexo
    fecha_nacimiento
}

hierarchy h_estudiante Estudiante partial

entity Estudiante_Especial extends h_estudiante {
    numero_expediente key
    descripcion
    atencion_especial
}       

entity Persona {
    nif key
    nombre
    apellido1
    apellido2
    telefono
    direccion
}

hierarchy h_persona Persona total overlapping

entity Tutora extends h_persona{
    nif key
    profesion
}

entity Docente extends h_persona{
    nif key
    salario
    cuenta 
}
relationship a_cargo_de {
    Estudiante[1..N] -> Tutora[1..N]
    relacion
}

