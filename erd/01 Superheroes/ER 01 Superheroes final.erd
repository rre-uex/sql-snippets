erdiagram Model
notation=crowsfoot

entity Superheroe {
    nombre key  
    fecha
}

entity Planeta {
    codigo key  
    nombre
    sistema_planetario
    coordenadas
}

relationship procede {
    Superheroe[0..N] -> Planeta[0..1]
}

entity Superpoder {
    codigo key  
    descripcion
}

relationship posee {
    Superheroe[0..N] -> Superpoder[1..N]  
    nivel
}

relationship coordina {
    Superheroe[0..1] -> Planeta[0..1] 
    fecha_inicio
}

relationship responsable_de {
    Superheroe[0..1 | "Superior" ] -> Superheroe[0..N | "Subordinado"] 
}

entity Tipo_Mision {
    codigo key  
    descripcion
    grado_dificultad
}

weak entity Mision_Realizada {
    fecha_realizacion partial-key
}

weak relationship ha_realizado {
    Mision_Realizada[0..N] -> Superheroe[1..1]     
}

weak relationship categorizada_como {
    Mision_Realizada[0..N] -> Tipo_Mision[1..1] 
}
