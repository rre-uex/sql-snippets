erdiagram Model
notation=crowsfoot

entity Superheroe {
    nombre key  
    fecha
}

entity Planeta {
    codigo key  
    nombre
    sistema_planetario
    coordenadas
}

relationship procede {
    Superheroe[0..N] -> Planeta[0..1]
}

entity Superpoder {
    cod_superpoder key  
    descripcion
}

relationship posee {
    Superheroe[0..N] -> Superpoder[1..N]  
    nivel
}

relationship coordina {
    Superheroe[0..1] -> Planeta[0..1] 
    fecha_inicio
}

relationship responsable_de {
    Superheroe[0..1 | "Superior" ] -> Superheroe[0..N | "Subordinado"] 
}

entity Tipo_Mision {
    codigo key  
    descripcion
    grado_dificultad
}


//esta relación tiene un problema 
//si se repite en el tiempo
relationship haRealizado {
    Tipo_Mision[0..N] -> Superheroe[0..N]
    fecha_realizacion     
}


