erdiagram Model
notation=crowsfoot

entity Superheroe {
    nombre key  
    fecha
}

entity Planeta {
    codigo key  
    nombre
    sistema_planetario
    coordenadas
}

relationship procede {
    Superheroe[0..N] -> Planeta[0..1]
}

entity Superpoder {
    codigo key  
    descripcion
}

relationship posee {
    Superheroe[0..N] -> Superpoder[1..N]  
    nivel
}




