erdiagram Model

notation=crowsfoot

entity Persona_UEX {
nif key
}

hierarchy h_persona_uex Persona_UEX total overlapping

entity Empleado extends h_persona_uex {
nif key
}

entity Estudiante extends h_persona_uex {
nif key
}

hierarchy h_empleado Empleado total overlapping

entity Docente extends h_empleado {
nif key
}
entity PTGAS extends h_empleado {
nif key
}

hierarchy h_docente Docente partial disjoint

entity Catedratico extends h_docente {
nif key
}

entity Titular extends h_docente {
nif key
}

hierarchy h_estudiante Estudiante partial

entity Estudiante_Politecnica extends h_estudiante {
nif key
}

hierarchy h_edad Estudiante_Politecnica total disjoint

entity Mayor_De_Edad extends h_edad {
nif key
}

entity Menor_De_Edad extends h_edad {
nif key
}

hierarchy h_titulacion Estudiante_Politecnica partial overlapping

entity Estudiante_Informatica extends h_titulacion {
nif key
}

entity Estudiante_Civil extends h_titulacion {
nif key
}

entity Estudiante_Edificacion extends h_titulacion {
nif key
}
