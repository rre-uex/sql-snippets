erdiagram Model
notation=crowsfoot

entity Serie {
    id_serie key
    titulo
    sinopsis
    fecha_lanzamiento
    estado
}

entity Productora {
    id_productora key
    nombre
    url
}

relationship producida_por {
    Serie [1..N] -> Productora [1..N]

}

///

entity Genero {
    id_genero key
    nombre
    descripcion
}

relationship clasificada_como {
    Serie [0..N] -> Genero [1..N]
}

entity Clasificacion_Edad {
    id_clasificacion key
    edad_minima
}

relationship tiene_clasificacion {
    Serie [0..N] -> Clasificacion_Edad [1..1]
}


//

weak entity Temporada {
    numero_temporada partial-key         
    novedades
}

weak relationship pertenece_a {
    Serie [1..1] -> Temporada [1..N]
}

//

weak entity Episodio {
    numero_episodio partial-key
    titulo
    fecha_primera_emision
    duracion
    sinopsis
}

weak relationship contiene {
    Temporada [1..1] -> Episodio [1..N]
}

//

entity Idioma {
    id_idioma key           
    nombre
}

relationship audio_disponible {
    Episodio [0..N] -> Idioma [1..N]
}

relationship subtitulos_disponibles {
    Episodio [0..N] -> Idioma [0..N]
}

//

entity Persona {
    id_persona key
    nombre
    apellido
    fecha_nacimiento
    nacionalidad
    bio
}

//total, solapada
entity Creador extends Persona {
    id_persona key
}

relationship ha_creado {
    Creador [1..N] -> Serie [1..N] 
}

//total, solapada
entity Director extends Persona {
    id_persona key
}

relationship dirige_episodio {
    Director [1..N] -> Episodio [1..N] 
}

//total, solapada
entity Interprete extends Persona {
    id_persona key
    nombre_artistico
}

entity Personaje {    
    id_personaje key
    nombre
    descripcion 
}

relationship actuacion {
    Interprete[1..N] -> Personaje[1..N] -> Episodio[1..N]
    minutos
    version_del_personaje
}

entity Plataforma {
    id_plataforma key
    nombre_comercial
    url
}

weak entity Derechos_Emision {
    fecha_inicio partial-key
    fecha_fin
}

weak relationship licencia_plataforma {
    Plataforma [1..1] -> Derechos_Emision [1..N]
}

weak relationship derechos_serie {
    Derechos_Emision [1..N] -> Serie [1..1] 
}
